+func tomlEscape(_ raw: String) -> String {
+    raw.unicodeScalars.map { scalar in
+        switch scalar.value {
+            case 0x08: "\\b"
+            case 0x09: "\\t"
+            case 0x0A: "\\n"
+            case 0x0C: "\\f"
+            case 0x0D: "\\r"
+            case 0x22: "\\\""
+            case 0x5C: "\\\\"
+            case 0x00 ... 0x1F, 0x7F ... 0x9F:
+                String(format: "\\u%04X", scalar.value)
+            default:
+                String(scalar)
+        }
+    }.joined()
 }
